(progn
(setq f (open "C:/Users/Administrator/AccioWork/2026-09-23-11-10-37-733-bbe0310b/tools/qa-residual-out.txt" "w"))
(write-line "START" f)
(defun edg (x) (vl-catch-all-apply 'entget (list x)))
(defun walkrec (nm tag / h e d ty tx)
 (setq h (vl-catch-all-apply 'tblobjname (list "BLOCK" nm)))
 (if (and h (not (vl-catch-all-error-p h)))
  (progn
   (write-line (strcat "REC|" tag) f)
   (setq e (entnext h))
   (while e
    (setq d (edg e))
    (if (not (vl-catch-all-error-p d))
     (progn
      (setq ty (cdr (assoc 0 d)))
      (if (equal ty "ENDBLK")
       (setq e nil)
       (progn
        (setq tx (cdr (assoc 1 d)))
        (if tx (write-line (strcat "H|" tag "|" ty "|" (cdr (assoc 5 d)) "|" tx) f))
        (setq e (entnext e))
       )
      )
     )
     (setq e (entnext e))
    )
   )
  )
  (write-line (strcat "REC|" tag "|MISSING") f)
 )
)
(foreach nm (list "*Model_Space" "*Paper_Space" "*Paper_Space0" "*Paper_Space1" "*Paper_Space2")
 (walkrec nm (strcat "SPACE:" nm))
)
(setq b (tblnext "BLOCK" T))
(while b
 (walkrec (cdr (assoc 2 b)) (strcat "BLOCK:" (cdr (assoc 2 b))))
 (setq b (tblnext "BLOCK"))
)
(close f)
(princ "\nQA RESIDUAL DONE\n")
)
