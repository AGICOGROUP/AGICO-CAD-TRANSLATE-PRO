<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)=/src/cad/</PathMap>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Host matrix: one AutoCAD release per build, selected with -p:AutoCADRelease=YYYY. The property
       flows to every project in the graph, so Core/Contracts build for the same runtime as the plugin.
       Reference assemblies come from the official AutoCAD.NET NuGet packages, so a release can be
       compiled without that AutoCAD version installed (acceptance still needs the real host).
       CadHostFramework is the library TFM; the native project appends -windows on .NET 8+. -->
  <PropertyGroup Condition="'$(AutoCADRelease)' != ''">
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)'=='' and '$(AutoCADRelease)'=='2020'">23.1.0</AutoCADNetVersion>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)'=='' and '$(AutoCADRelease)'=='2021'">24.0.0</AutoCADNetVersion>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)'=='' and '$(AutoCADRelease)'=='2022'">24.1.51000</AutoCADNetVersion>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)'=='' and '$(AutoCADRelease)'=='2023'">24.2.0</AutoCADNetVersion>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)'=='' and '$(AutoCADRelease)'=='2024'">24.3.0</AutoCADNetVersion>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)'=='' and '$(AutoCADRelease)'=='2025'">25.0.2</AutoCADNetVersion>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)'=='' and '$(AutoCADRelease)'=='2026'">25.1.1</AutoCADNetVersion>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)'=='' and '$(AutoCADRelease)'=='2027'">26.0.0</AutoCADNetVersion>
    <CadHostFramework Condition="'$(CadHostFramework)'=='' and '$(AutoCADRelease)'=='2020'">net47</CadHostFramework>
    <CadHostFramework Condition="'$(CadHostFramework)'=='' and '$(AutoCADRelease)'=='2021'">net48</CadHostFramework>
    <CadHostFramework Condition="'$(CadHostFramework)'=='' and '$(AutoCADRelease)'=='2022'">net48</CadHostFramework>
    <CadHostFramework Condition="'$(CadHostFramework)'=='' and '$(AutoCADRelease)'=='2023'">net48</CadHostFramework>
    <CadHostFramework Condition="'$(CadHostFramework)'=='' and '$(AutoCADRelease)'=='2024'">net48</CadHostFramework>
    <CadHostFramework Condition="'$(CadHostFramework)'=='' and '$(AutoCADRelease)'=='2025'">net8.0</CadHostFramework>
    <CadHostFramework Condition="'$(CadHostFramework)'=='' and '$(AutoCADRelease)'=='2026'">net8.0</CadHostFramework>
    <CadHostFramework Condition="'$(CadHostFramework)'=='' and '$(AutoCADRelease)'=='2027'">net10.0</CadHostFramework>
  </PropertyGroup>
  <!-- .NET Framework hosts (AutoCAD 2020-2024) miss System.Text.Json and several BCL members; the shims
       are supplied here so Contracts, Core and the plugin project get them from one place. Reference
       assemblies let the build run on machines without the .NET Framework targeting pack installed.
       NetFxPolyfills is linked for every target framework: the static shims are unconditional so shared
       source keeps one code path, and the framework-specific parts are guarded inside the file. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Build\NetFxPolyfills.cs" Link="NetFxPolyfills.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Build\NetFxGlobalUsings.cs" Link="NetFxGlobalUsings.cs" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- Nullable analysis for net4x is switched in Directory.Build.targets: $(TargetFramework) is still
       empty while this file is evaluated. -->
</Project>
