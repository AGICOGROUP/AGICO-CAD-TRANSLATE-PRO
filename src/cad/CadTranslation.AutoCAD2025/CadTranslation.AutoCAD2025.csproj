<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AutoCADRelease Condition="'$(AutoCADRelease)'==''">2025</AutoCADRelease>
    <AutoCADTargetFramework Condition="'$(AutoCADTargetFramework)'=='' and '$(AutoCADRelease)'=='2027'">net10.0-windows</AutoCADTargetFramework>
    <AutoCADTargetFramework Condition="'$(AutoCADTargetFramework)'==''">net8.0-windows</AutoCADTargetFramework>
    <TargetFramework>$(AutoCADTargetFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AutoCADDir Condition="'$(AutoCADDir)'=='' and '$(AutoCADRelease)'=='2025'">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADDir>
    <AutoCADDir Condition="'$(AutoCADDir)'=='' and '$(AutoCADRelease)'=='2027'">C:\Program Files\Autodesk\AutoCAD 2027</AutoCADDir>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NativeContactTests" />
    <ProjectReference Include="..\CadTranslation.Contracts\CadTranslation.Contracts.csproj" />
    <ProjectReference Include="..\CadTranslation.Core\CadTranslation.Core.csproj" />
    <Reference Include="AcCoreMgd" HintPath="$(AutoCADDir)\accoremgd.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd" HintPath="$(AutoCADDir)\acdbmgd.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd" HintPath="$(AutoCADDir)\acmgd.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target
    Name="RequireAutoCADManagedAssemblies"
    BeforeTargets="ResolveReferences"
    Condition="!Exists('$(AutoCADDir)\accoremgd.dll')"
  >
    <Error Text="AutoCAD $(AutoCADRelease) managed assemblies were not found at $(AutoCADDir)." />
  </Target>
</Project>
